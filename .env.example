# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_NAME=HelloLobby
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1
SUPPORT_EMAIL=support@hellolobby.com

# ---------------------------------------------------------------------------
# Database
# MongoDB Atlas: Connect > Drivers > copy the connection string.
# URL-encode the password if it contains @ # % : / ? & characters.
# ---------------------------------------------------------------------------
MONGO_URI=mongodb+srv://<user>:<password>@<cluster-host>/hellolobby?retryWrites=true&w=majority

# ---------------------------------------------------------------------------
# JWT — use two DIFFERENT random strings (min 32 chars each).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=replace_with_a_long_random_string
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=1d
JWT_REFRESH_REMEMBER_ME_EXPIRES_IN=30d
JWT_ISSUER=hellolobby-api
JWT_AUDIENCE=hellolobby-client

# ---------------------------------------------------------------------------
# CORS / links in emails. Comma-separated list; the first entry is used to
# build verification and password-reset URLs.
# ---------------------------------------------------------------------------
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Security policy
# ---------------------------------------------------------------------------
BCRYPT_SALT_ROUNDS=12
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15
PASSWORD_RESET_TOKEN_MINUTES=15
EMAIL_VERIFICATION_TOKEN_HOURS=24
# Only set in production when the API and SPA share a parent domain.
# COOKIE_DOMAIN=.hellolobby.com

# ---------------------------------------------------------------------------
# SMTP — optional in development. When blank, verification and reset links are
# printed to the server console instead of being emailed.
# Gmail: enable 2-Step Verification, then create an App Password.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=HelloLobby <no-reply@hellolobby.com>

# ---------------------------------------------------------------------------
# First super admin, created by: npm run seed:super-admin
# ---------------------------------------------------------------------------
SEED_SUPER_ADMIN_NAME=Super Admin
SEED_SUPER_ADMIN_EMAIL=
SEED_SUPER_ADMIN_PASSWORD=
